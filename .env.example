# Contraseña del panel /admin en la demo. Cámbiala en Vercel (Settings > Environment Variables).
ADMIN_DEMO_PASSWORD=cambia-esta-clave
# Secreto para firmar la cookie de sesión del panel (32+ caracteres aleatorios).
ADMIN_SESSION_SECRET=pon-aqui-un-secreto-largo-y-aleatorio
# URL pública del sitio (para sitemap, robots y JSON-LD).
NEXT_PUBLIC_SITE_URL=https://pequenos-suenos.vercel.app
# Integración futura con Resend (la demo NO envía correos reales).
# RESEND_API_KEY=
# CORREO_REMITENTE=
